              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahim\",\n  \"email\": \"rahim@gmail.com\",\n  \"age\": 22\n}"
            },
            "url": "http://localhost:3000/students"
          }
        },
        {
          "name": "PUT update student",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"name\": \"Karim Updated\",\n  \"age\": 23\n}"
            },
            "url": "http://localhost:3000/students"
          }
        },
        {
          "name": "DELETE student",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
